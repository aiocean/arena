<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>io.aiocean.arena-watchdog</string>

  <!-- the arena's watchdog (projects/arena crates/arena-telemetry examples/watchdog.rs, ops/telemetry/README.md,
       "The watchdog"): every five minutes it checks the live server's telemetry files, writes a watchdog.check line a
       check to telemetry/arena-watchdog/, a line to arena-alerts.log, and a notification when a check starts failing -->
  <key>ProgramArguments</key>
  <array>
    <string>/Users/firegroup/services/arena/watchdog/watchdog</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>/Users/firegroup</string>
    <key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin</string>
    <!-- the telemetry files it reads (the live server's) and writes (its own) -->
    <key>ARENA_TELEMETRY_DIR</key><string>/Users/firegroup/services/arena/telemetry</string>
  </dict>
  <key>StartInterval</key><integer>300</integer>
  <key>RunAtLoad</key><true/>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>/Users/firegroup/Library/Logs/game-factory/arena-watchdog.log</string>
  <key>StandardErrorPath</key><string>/Users/firegroup/Library/Logs/game-factory/arena-watchdog.log</string>
</dict>
</plist>
