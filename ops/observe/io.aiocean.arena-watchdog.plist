<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>io.aiocean.arena-watchdog</string>

  <!-- the arena's watchdog (projects/arena crates/arena-telemetry examples/watchdog.rs, ops/observe/README.md,
       "Alerts"): every five minutes it checks the live server and the telemetry store, writes a row a check to the
       stream arena_alerts, a line to arena-alerts.log, and a notification when a check starts failing -->
  <key>ProgramArguments</key>
  <array>
    <string>/Users/firegroup/services/arena/observe/watchdog</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>/Users/firegroup</string>
    <key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin</string>
    <!-- the store; the credentials are read from the file, never put here -->
    <key>ARENA_OTLP_ENDPOINT</key><string>http://127.0.0.1:5080/api/default</string>
    <key>ARENA_OTLP_AUTH_FILE</key><string>/Users/firegroup/projects/game-factory/ops/arena/observe.env</string>
  </dict>
  <key>StartInterval</key><integer>300</integer>
  <key>RunAtLoad</key><true/>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>/Users/firegroup/Library/Logs/game-factory/arena-watchdog.log</string>
  <key>StandardErrorPath</key><string>/Users/firegroup/Library/Logs/game-factory/arena-watchdog.log</string>
</dict>
</plist>
