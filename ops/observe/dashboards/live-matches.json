                "stream": "arena_match",
                "stream_type": "logs",
                "x": [
                  {
                    "alias": "x_axis_1",
                    "color": null,
                    "column": "x_axis_1",
                    "label": "Opponent"
                  }
                ],
                "y": [
                  {
                    "alias": "matches",
                    "color": null,
                    "column": "matches",
                    "label": "Matches"
                  },
                  {
                    "alias": "house_wins",
                    "color": null,
                    "column": "house_wins",
                    "label": "House wins"
                  },
                  {
                    "alias": "mind_wins",
                    "color": null,
                    "column": "mind_wins",
                    "label": "Mind wins"
                  },
                  {
                    "alias": "draws_cuts",
                    "color": null,
                    "column": "draws_cuts",
                    "label": "Draws / cuts"
                  },
                  {
                    "alias": "house_win_pct",
                    "color": null,
                    "column": "house_win_pct",
                    "label": "House win %"
                  }
                ],
                "z": []
              },
              "query": "SELECT CASE WHEN bot_0 = 'house' THEN bot_1 ELSE bot_0 END AS x_axis_1, count(*) AS matches, sum(CASE WHEN result IN ('seat0', 'seat1') AND winner_bot = 'house' THEN 1 ELSE 0 END) AS house_wins, sum(CASE WHEN result IN ('seat0', 'seat1') AND winner_bot != 'house' THEN 1 ELSE 0 END) AS mind_wins, sum(CASE WHEN result IN ('draw', 'cut') THEN 1 ELSE 0 END) AS draws_cuts, round(100.0 * sum(CASE WHEN result IN ('seat0', 'seat1') AND winner_bot = 'house' THEN 1 ELSE 0 END) / count(*), 1) AS house_win_pct FROM arena_match WHERE body = 'match.end' AND service_name = 'arena-server' AND (bot_0 = 'house' OR bot_1 = 'house') AND result IN ('seat0', 'seat1', 'draw', 'cut') GROUP BY x_axis_1 ORDER BY x_axis_1",
              "vrlFunctionQuery": ""
            }
          ],
          "queryType": "sql",
          "title": "Results by pairing",
