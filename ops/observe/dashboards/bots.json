              "query": "SELECT concat(runtime, '/', bot) AS x_axis_1, count(*) AS instances, sum(matches) AS matches, sum(decisions) AS decisions, sum(think_p50_ms * decisions) / sum(decisions) AS p50, sum(think_p95_ms * decisions) / sum(decisions) AS p95, sum(think_p99_ms * decisions) / sum(decisions) AS p99, max(think_max_ms) AS most, sum(faults) AS faults FROM arena_bot WHERE body = 'bot.end' AND runtime IS NOT NULL GROUP BY x_axis_1 ORDER BY x_axis_1",
